# ---------- 密钥与本地配置（切勿提交） ----------
web/js/config.js
ios/XiangqiCoach/Resources/AppConfig.local.plist
*.local.plist
secrets.json

# ---------- 系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Node ----------
node_modules/
npm-debug.log*
yarn-error.log*

# ---------- Xcode ----------
# 工程文件由 XcodeGen 从 ios/project.yml 生成，不纳入版本管理
ios/*.xcodeproj/
ios/*.xcworkspace/
ios/build*/
DerivedData/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# ---------- 测试临时产物 ----------
_probe.html
_cors.html
_s_*.html
/*.png
!/docs/screenshots/*.png

# ---------- Python ----------
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ---------- 训练包 ----------
# 引擎与自己下的权重不进仓库：体积大（exe 7MB + nnue 50MB），
# 而且权重有独立许可，不适合随本仓库分发
trainer/engine/*.exe
trainer/engine/pikafish*
trainer/engine/*.nnue

# 训练产物（数据动辄几个 GB，checkpoint 每次重跑都会覆盖）
trainer/data/
trainer/logs/
# 一键流程的产出目录（报告、positions.json、网络副本）
trainer/results/
_train*/

# 拷去 Windows 跑整条流水线的压缩包（临时产物，随时可重新生成）
/*.zip

# ---------- iOS 打包产物与本地配置 ----------
# 与 WeiLian 项目同一套做法：导出配置（含 Team ID、描述文件映射）和 .ipa
# 都放这里，不进仓库。生成工程时用 TEAM_ID=<你的团队> xcodegen generate。
.workbuddy/
ios/archive/
*.ipa


# net-in-engine 的派生产物：14MB 权重 JSON、参考值、打过补丁的引擎副本
# 都可用 tools/net-in-engine 下的脚本随时重新生成
tools/net-in-engine/net_d512.json
tools/net-in-engine/ref_cp.json
tools/net-in-engine/engine.js

# 对局台用的 UCI 前端编译产物（tools/uci/run.sh 随时可重新生成）
tools/uci/build/
