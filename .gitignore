# ---------- 密钥与本地配置（切勿提交） ----------
web/js/config.js
ios/XiangqiCoach/Resources/AppConfig.local.plist
*.local.plist
secrets.json

# ---------- 系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Node ----------
node_modules/
npm-debug.log*
yarn-error.log*

# ---------- Xcode ----------
# 工程文件由 XcodeGen 从 ios/project.yml 生成，不纳入版本管理
ios/*.xcodeproj/
ios/*.xcworkspace/
ios/build*/
DerivedData/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# ---------- 测试临时产物 ----------
_probe.html
_cors.html
_s_*.html
/*.png
!/docs/screenshots/*.png

# ---------- Python ----------
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ---------- 训练包 ----------
# 引擎与自己下的权重不进仓库：体积大（exe 7MB + nnue 50MB），
# 而且权重有独立许可，不适合随本仓库分发
trainer/engine/*.exe
trainer/engine/pikafish*
trainer/engine/*.nnue

# 训练产物（数据动辄几个 GB，checkpoint 每次重跑都会覆盖）
trainer/data/
trainer/logs/
_train*/

