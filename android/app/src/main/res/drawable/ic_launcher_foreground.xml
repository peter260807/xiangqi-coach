<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景：「帅」棋子 + 棋盘网格。

  设计取自 iOS 的 AppIcon（红底 + 淡棋盘网格 + 木质「帅」棋子），
  但两端的画法不同：iOS 那张是 1024 的实心方图，Android 的自适应图标要拆成
  前景 + 背景两层，并且**前景只占中间 66% 的安全区**（外面的圆/方形/水滴形裁切
  由启动器决定）。所以这里把棋子画小一点、网格铺满 108×108 全幅，
  让裁切之后看起来仍然是「一张棋盘上摆着一枚帅」。

  棋子里的「帅」字用字形路径直接嵌进来：这个图标必须在没有中文字体的环境下
  也能渲染（矢量图里嵌 <text> 依赖系统字体，AAPT 也会直接报错）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 棋盘网格：4 条横线 + 4 条竖线，铺满全幅 -->
    <path
        android:strokeColor="#33F4F1EA"
        android:strokeWidth="1.2"
        android:pathData="M27,0 V108 M54,0 V108 M81,0 V108 M0,27 H108 M0,54 H108 M0,81 H108" />

    <!-- 棋子外圈（木色深边） -->
    <path
        android:fillColor="#FF8E6A47"
        android:pathData="M54,20 a34,34 0 1,0 0.1,0 z" />
    <!-- 棋子面（米色） -->
    <path
        android:fillColor="#FFF2E8D5"
        android:pathData="M54,25 a29,29 0 1,0 0.1,0 z" />
    <!-- 内圈细线 -->
    <path
        android:strokeColor="#FF9E2B25"
        android:strokeWidth="1.6"
        android:pathData="M54,29 a25,25 0 1,0 0.1,0 z" />

    <!-- 「帅」字：米字旁 + 巾字边，红色填充 -->
    <group>
        <!-- 左半边：米字旁（两点 + 十字） -->
        <path
            android:fillColor="#FF9E2B25"
            android:pathData="M43.5,37.5 L47.5,37.5 L47.5,71.5 L43.5,71.5 z" />
        <path
            android:fillColor="#FF9E2B25"
            android:pathData="M36.5,42.5 L54.5,42.5 L54.5,46 L36.5,46 z" />
        <path
            android:fillColor="#FF9E2B25"
            android:pathData="M37.5,52.5 L53.5,52.5 L53.5,56 L37.5,56 z" />
        <path
            android:fillColor="#FF9E2B25"
            android:pathData="M37.5,62.5 L53.5,62.5 L53.5,66 L37.5,66 z" />
        <!-- 右半边：巾字（左竖 + 横折钩 + 中竖） -->
        <path
            android:fillColor="#FF9E2B25"
            android:pathData="M55.5,44 L59.5,44 L59.5,74 L55.5,74 z" />
        <path
            android:fillColor="#FF9E2B25"
            android:pathData="M55.5,44 L72,44 L72,48 L55.5,48 z" />
        <path
            android:fillColor="#FF9E2B25"
            android:pathData="M68,44 L72,44 L72,70 L68,70 z" />
        <path
            android:fillColor="#FF9E2B25"
            android:pathData="M62.5,48 L66.5,48 L66.5,74 L62.5,74 z" />
    </group>
</vector>
